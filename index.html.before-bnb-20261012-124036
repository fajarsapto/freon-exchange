async function runTx(promise,label,where="tradeMessage"){
 try{
  if(!signer || !account) throw new Error("Hubungkan wallet terlebih dahulu.");
  await requireSepolia();
  message(where,"Menunggu konfirmasi wallet…");
  const tx=await promise;
  message(where,`${label}: transaksi dikirim. Hash: ${tx.hash}`,"notice");
  $("lastTx").innerHTML=`${label}: <a target="_blank" rel="noopener" href="${txLink(tx.hash)}">${tx.hash.slice(0,12)}…${tx.hash.slice(-8)}</a>`;
  const receipt=await tx.wait();
  let violation=false;
  if(exchange && receipt){
   for(const log of receipt.logs){
    try { const parsed=exchange.interface.parseLog(log); if(parsed?.name==="SellViolation") violation=true; } catch {}
   }
  }
  if(violation){
   message(where,`PELANGGARAN TERDETEKSI. Transaksi ${tx.hash} memicu aturan exchange; ETH tidak dibayarkan dan wallet masuk blacklist permanen di FREON EXCHANGE.`,"error");
   $("lastTx").innerHTML=`<b>SELL VIOLATION</b> · <a target="_blank" rel="noopener" href="${txLink(tx.hash)}">${tx.hash}</a>`;
  } else {
   message(where,`${label} berhasil dikonfirmasi. Hash: ${tx.hash}`,"success");
  }
  await refresh();
 }catch(e){ message(where,e?.shortMessage||e?.reason||e?.message||"Transaksi gagal.","error"); }
}
