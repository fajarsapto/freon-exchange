<script>\n/* FREON_DB_CHART_INTEGRATION */
(() => {
  const historyKey = 'freon_frn_price_history_v1';

  window.addEventListener('freon:history', (event) => {
    const payload = event.detail;
    const rows = Array.isArray(payload) ? payload :
      (payload && Array.isArray(payload.data) ? payload.data :
      (payload && Array.isArray(payload.history) ? payload.history : null));

    if (!rows) {
      console.warn('FREON: format respons riwayat belum dikenali; grafik lama dipertahankan.');
      return;
    }

    const points = rows.map(row => {
      const t = new Date(row.recorded_at || row.t || row.timestamp).getTime();
      const usd = Number(row.frn_price_usd);
      const ethUsd = Number(row.eth_price_usd);
      const p = Number(row.p ?? (ethUsd > 0 ? usd / ethUsd : NaN));
      return { t, p };
    }).filter(point =>
      Number.isFinite(point.t) && Number.isFinite(point.p) && point.p > 0
    );

    if (!points.length) return;

    try {
      localStorage.setItem(historyKey, JSON.stringify(points));
      if (typeof window.drawPriceChart === 'function') window.drawPriceChart();
    } catch (error) {
      console.error('FREON: gagal memperbarui grafik', error);
    }
  });
})();
</script>
