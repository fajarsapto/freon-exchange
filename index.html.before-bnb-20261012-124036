async function setExchangePaused(target){
 try{
  if(!signer || !account) throw new Error("Hubungkan wallet owner terlebih dahulu.");
  await requireSepolia();
  const owner=await exchange.owner();
  if(owner.toLowerCase()!==account.toLowerCase()) throw new Error("Wallet aktif bukan owner kontrak.");
  const current=await exchange.paused();
  if(current===target){ message("adminMessage",target?"Exchange sudah dalam keadaan PAUSED.":"Exchange sudah aktif (UNPAUSED).","notice"); await refresh(); return; }
  message("adminMessage",target?"Meminta wallet menandatangani PAUSE…":"Meminta wallet menandatangani UNPAUSE / RESUME…","notice");
  // Call only after explicit click, to trigger the wallet signature prompt.
  const tx=await exchange.setPaused(target);
  message("adminMessage",`Permintaan dikirim. Menunggu konfirmasi blockchain… Hash: ${tx.hash}`,"notice");
  $("lastTx").innerHTML=`${target?"Pause":"Unpause"}: <a target="_blank" rel="noopener" href="${txLink(tx.hash)}">${tx.hash}</a>`;
  const receipt=await tx.wait();
  if(!receipt || receipt.status!==1) throw new Error("Transaksi tidak berhasil. Periksa TxHash di Etherscan Sepolia.");
  await refresh();
  const actual=await exchange.paused();
  if(actual!==target) throw new Error("Transaksi terkonfirmasi tetapi status paused tidak sesuai. Periksa kontrak dan TxHash.");
  message("adminMessage",target?"Exchange berhasil di-PAUSE.":"Exchange berhasil di-UNPAUSE / RESUME. Buy/Sell tetap mengikuti pengaturan masing-masing.","success");
 }catch(e){
  const msg=e?.shortMessage||e?.reason||e?.message||"Gagal mengubah status pause.";
  message("adminMessage",msg+" Jika popup tidak muncul, periksa sesi WalletConnect/Bitget Wallet dan coba sambungkan ulang.","error");
 }
}
