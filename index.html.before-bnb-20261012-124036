$("buyBtn").addEventListener("click",async()=>{
 try{
   if(!signer||!exchange||!provider||!account) throw new Error("Hubungkan wallet terlebih dahulu.");
   await requireSepolia();
   const amount=$("buyAmount").value;
   if(!amount||!Number.isFinite(Number(amount))||Number(amount)<=0) throw new Error("Masukkan jumlah ETH yang valid.");
   const value=parseEth(amount);
   const balance=await provider.getBalance(account);
   if(balance<value) throw new Error("Saldo ETH Sepolia tidak cukup untuk jumlah pembelian.");
   const [isPaused,isLaunched,isBuyEnabled,isBlocked]=await Promise.all([
     exchange.paused(),exchange.launched(),exchange.buyEnabled(),exchange.blacklisted(account)
   ]);
   if(isPaused) throw new Error("Exchange sedang PAUSED. Owner harus melakukan Unpause terlebih dahulu.");
   if(!isLaunched) throw new Error("Exchange belum di-launch oleh owner.");
   if(!isBuyEnabled) throw new Error("Fitur Buy sedang OFF. Owner harus mengaktifkan Toggle Buy.");
   if(isBlocked) throw new Error("Wallet ini masuk blacklist kontrak dan tidak dapat melakukan Buy.");
   const q=await exchange.quoteBuy(value);
   if(!q||q[0]<=0n) throw new Error("Quote Buy FRN tidak valid atau cadangan tidak mencukupi.");
   const min=q[0]*9500n/10000n; // toleransi slippage 5% untuk menghindari revert SLIPPAGE_OR_ZERO
   // Simulasi transaksi lebih dahulu agar alasan revert dari smart contract ditampilkan sebelum wallet diminta konfirmasi.
   try { await exchange.buy.staticCall(min,{value}); }
   catch(simErr) {
     throw new Error("Kontrak menolak Buy: "+(simErr?.shortMessage||simErr?.reason||simErr?.revert?.name||simErr?.message||"simulasi gagal")+". Periksa saldo cadangan, status launch, Buy ON, dan aturan kontrak.");
   }
   const gas=await exchange.buy.estimateGas(min,{value});
   const gasLimit=gas*120n/100n;
   const feeData=await provider.getFeeData();
   if(feeData.maxFeePerGas && balance < value + gasLimit*feeData.maxFeePerGas)
     throw new Error("Saldo ETH cukup untuk nilai Buy tetapi tidak cukup untuk biaya gas.");
   const tx=await exchange.buy(min,{value,gasLimit});
   await runTx(Promise.resolve(tx),"Buy FRN");
 }catch(e){
   message("tradeMessage",e?.shortMessage||e?.reason||e?.message||"Transaksi Buy gagal.","error");
 }
});
$("sellBtn").addEventListener("click",async()=>{
 const btn=$("sellBtn"), oldText=btn.textContent;
 btn.disabled=true; btn.textContent="Processing Sell…";
 try{
   if(!signer||!token||!exchange||!provider||!account) throw new Error("Hubungkan wallet terlebih dahulu.");
   await requireSepolia();
   const amount=$("sellAmount").value;
   if(!amount||!Number.isFinite(Number(amount))||Number(amount)<=0) throw new Error("Masukkan jumlah FRN yang valid.");
   const amountWei=parseToken(amount);
   const [balance,isPaused,isLaunched,isSellEnabled,isBlocked]=await Promise.all([
     token.balanceOf(account),exchange.paused(),exchange.launched(),exchange.sellEnabled(),exchange.blacklisted(account)
   ]);
   if(amountWei>balance) throw new Error("Saldo FRN tidak mencukupi.");
   if(isPaused) throw new Error("Exchange sedang PAUSED. Owner harus melakukan Unpause terlebih dahulu.");
   if(!isLaunched) throw new Error("Exchange belum di-launch oleh owner.");
   if(!isSellEnabled) throw new Error("Fitur Sell sedang OFF. Owner harus mengaktifkan Toggle Sell.");
   if(isBlocked) throw new Error("Wallet ini masuk blacklist kontrak dan tidak dapat melakukan Sell.");

   let allowance=await token.allowance(account,EXCHANGE_ADDRESS);
   if(allowance<amountWei){
     message("tradeMessage","Konfirmasi Approve FRN di wallet terlebih dahulu…");
     const approveTx=await token.approve(EXCHANGE_ADDRESS,amountWei);
     $("lastTx").innerHTML=`Approve FRN dikirim: <a target="_blank" rel="noopener" href="${txLink(approveTx.hash)}">${approveTx.hash}</a>`;
     await approveTx.wait();
     allowance=await token.allowance(account,EXCHANGE_ADDRESS);
     if(allowance<amountWei) throw new Error("Approval belum cukup. Coba ulangi Sell.");
   }

   const q=await exchange.quoteSell(amountWei);
   if(!q||q[1]<=0n) throw new Error("Quote Sell tidak valid atau cadangan ETH tidak mencukupi.");
   const min=q[1]*9950n/10000n;
   message("tradeMessage","Memeriksa transaksi Sell…");
   try { await exchange.sell.staticCall(amountWei,min); }
   catch(simErr) {
     throw new Error("Kontrak menolak Sell: "+(simErr?.shortMessage||simErr?.reason||simErr?.revert?.name||simErr?.message||"simulasi gagal")+". Periksa saldo cadangan, status exchange, Sell ON, dan aturan kontrak.");
   }
   const gas=await exchange.sell.estimateGas(amountWei,min);
   const tx=await exchange.sell(amountWei,min,{gasLimit:gas*120n/100n});
   await runTx(Promise.resolve(tx),"Sell FRN");
 }catch(e){
   message("tradeMessage",e?.shortMessage||e?.reason||e?.message||"Transaksi Sell gagal.","error");
 }finally{
   btn.textContent=oldText;
   if(provider&&account){ try{await refresh();}catch{} }
 }
});
