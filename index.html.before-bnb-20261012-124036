async function updateQuotes(){
 if(!exchange) return;
 try{
  const v=$("buyAmount").value;
  if(v && Number(v)>0){
   const q=await exchange.quoteBuy(parseEth(v));
   $("buyQuote").textContent=fmt(Number(ethers.formatUnits(q[0],tokenDecimals)));
   $("buyFeeQuote").textContent=fmt(Number(ethers.formatEther(q[1])),8)+" ETH";
  } else {$("buyQuote").textContent="—";$("buyFeeQuote").textContent="—";}
