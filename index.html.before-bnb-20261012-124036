   $("sellFeeQuote").textContent=fmt(Number(q[3])/100,2)+"% ("+fmt(Number(ethers.formatEther(q[2])),8)+" ETH)";
  } else {$("sellQuote").textContent="—";$("sellFeeQuote").textContent="—";}
 }catch(e){$("buyQuote").textContent="—";$("sellQuote").textContent="—";}
